#!/usr/bin/env bash
set -e
set -u
set -o pipefail

usage() {
  echo "Usage: $(basename "$0") [--base=ref]" >&2
}

base_ref=""

for arg in "$@"; do
  case "$arg" in
    --base=*) base_ref="${arg#*=}" ;;
    *)
      usage
      exit 1
      ;;
  esac
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "not a git repository" >&2
  exit 1
fi

# The branch point is the merge base with the default branch, so the count
# ignores anything that landed on the default branch after the branch was cut.
default_branch() {
  local ref candidate
  if ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null); then
    echo "${ref#refs/remotes/}"
    return
  fi
  for candidate in main master trunk; do
    if git show-ref --verify --quiet "refs/heads/$candidate"; then
      echo "$candidate"
      return
    fi
  done
  return 1
}

if [ -z "$base_ref" ] && ! base_ref=$(default_branch); then
  echo "cannot find a default branch; pass --base=ref" >&2
  exit 1
fi

if ! git rev-parse --verify --quiet "$base_ref" >/dev/null; then
  echo "unknown ref: $base_ref" >&2
  exit 1
fi

if ! base=$(git merge-base "$base_ref" HEAD 2>/dev/null); then
  echo "no common ancestor between HEAD and $base_ref" >&2
  exit 1
fi

# On the default branch itself the merge base is HEAD, so compare against the
# upstream to report what has not been pushed yet.
if [ "$base" = "$(git rev-parse HEAD)" ] && upstream=$(git rev-parse --verify --quiet '@{upstream}'); then
  base="$upstream"
  base_ref=$(git rev-parse --abbrev-ref '@{upstream}')
fi

branch=$(git rev-parse --abbrev-ref HEAD)
echo "$branch (since $base_ref)"

git log --reverse --numstat --format="%x01%h%x09%s" "$base..HEAD" | awk '
  BEGIN { FS = "\t" }

  substr($0, 1, 1) == "\001" {
    n++
    sha[n] = substr($1, 2)
    subject[n] = $2
    added[n] = 0
    deleted[n] = 0
    next
  }

  # Binary files report "-" for both counts and contribute nothing to the totals.
  NF >= 3 {
    if ($1 != "-") added[n] += $1
    if ($2 != "-") deleted[n] += $2
    next
  }

  END {
    if (n == 0) {
      print "no commits"
      exit
    }

    add_width = 0
    del_width = 0
    for (i = 1; i <= n; i++) {
      total_added += added[i]
      total_deleted += deleted[i]
      if (length(added[i]) > add_width) add_width = length(added[i])
      if (length(deleted[i]) > del_width) del_width = length(deleted[i])
    }
    if (length(total_added) > add_width) add_width = length(total_added)
    if (length(total_deleted) > del_width) del_width = length(total_deleted)

    printf "%d commit%s\n\n", n, (n == 1 ? "" : "s")
    for (i = 1; i <= n; i++)
      printf "  %s  +%*d  -%*d  %s\n", sha[i], add_width, added[i], del_width, deleted[i], subject[i]

    printf "\n  %*s  +%*d  -%*d  (net %+d)\n", length(sha[1]), "total", \
      add_width, total_added, del_width, total_deleted, total_added - total_deleted
  }
'
