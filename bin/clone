#!/usr/bin/env bash
set -e
set -u
set -o pipefail

usage() {
  echo "Usage: $(basename "$0") [--trust] [--rename=name] remote_repo path/to/directory" >&2
}

trust=false
rename=""
args=()

for arg in "$@"; do
  case "$arg" in
    --trust) trust=true ;;
    --rename=*) rename="${arg#*=}" ;;
    *) args+=("$arg") ;;
  esac
done

if [ "${#args[@]}" -ne 2 ]; then
  usage
  exit 1
fi

remote="${args[0]}"
path="${args[1]}"

if [ -z "$path" ]; then
  usage
  exit 1
fi

# Accept the target directory with or without trailing slashes. "/" strips to
# the empty string, which still joins into an absolute path below.
while [ "$path" != "${path%/}" ]; do
  path="${path%/}"
done

if [ -n "$rename" ]; then
  repo_name="$rename"
else
  repo_name=$(basename "$remote" .git)
fi
dest="$path/$repo_name"

mkdir -p "${path:-/}"
git clone "$remote" "$dest"

if [ "$trust" = true ]; then
  mise trust "$dest"
fi
